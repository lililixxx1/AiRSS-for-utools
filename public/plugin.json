{
  "main": "index.html",
  "preload": "preload/index.js",
  "logo": "logo.png",
  "pluginName": "AiRSS",
  "version": "2.1.0",
  "platform": ["win32", "darwin", "linux"],
  "pluginSetting": {
    "single": true,
    "height": 620
  },
  "features": [
    {
      "code": "airss",
      "description": "AiRSS 智能订阅阅读器",
      "mainPush": true,
      "cmds": ["AiRSS", "rss", "订阅", "阅读"]
    },
    {
      "code": "add_feed",
      "description": "订阅到 AiRSS",
      "cmds": [
        {
          "type": "regex",
          "label": "订阅到 AiRSS",
          "match": "/^https?:\\/\\/[^\\s/$.?#][^\\s]*$|^[a-z0-9][-a-z0-9]{0,62}(\\.[a-z0-9][-a-z0-9]{0,62})*\\.[a-z]{2,24}(:[0-9]{1,5})?(\\/[^\\s#?]*)?$/i",
          "minLength": 4,
          "maxLength": 500
        }
      ]
    },
    {
      "code": "save_later",
      "description": "将网页存入 AiRSS 稍后读",
      "mainHide": true,
      "cmds": [
        {
          "type": "regex",
          "label": "存入稍后读",
          "match": "/^https?:\\/\\/[^\\s/$.?#][^\\s]*$/i",
          "minLength": 10,
          "maxLength": 500
        }
      ]
    }
  ]
}
