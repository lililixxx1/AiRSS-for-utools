{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "node",
    "allowJs": true,
    "checkJs": false,
    "declaration": true,
    "emitDeclarationOnly": true,
    "outDir": "src/types/generated",
    "rootDir": "preload",
    "skipLibCheck": true,
    "strict": false,
    "esModuleInterop": true
  },
  "include": ["preload/index.js", "preload/ambient.d.ts"]
}
